.energy-ring-face{position:relative;width:100%;padding-top:100%;border-radius:50%}
.energy-ring-center{position:absolute;inset:10rpx;border-radius:50%;background:#EEF0E6;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}
.energy-ring-large .energy-ring-center{inset:12rpx}
.energy-ring-caption{font-size:18rpx;line-height:1.4;color:#526A58;white-space:nowrap}
.energy-ring-value{font-size:40rpx;font-weight:750;line-height:1.25;font-variant-numeric:tabular-nums;max-width:100%;letter-spacing:-1rpx}
.energy-ring-large .energy-ring-value{font-size:52rpx}
.energy-ring-unit{font-size:18rpx;line-height:1.4;color:#526A58;white-space:nowrap}
.energy-ring-status,.energy-ring-large .energy-ring-status{font-size:24rpx;letter-spacing:0}
