.diet-budget{display:grid;grid-template-columns:192rpx minmax(0,280rpx);column-gap:24rpx;row-gap:8rpx;justify-content:center;margin-bottom:24rpx;color:#173E32}
.diet-budget-title{align-self:end;text-align:center;font-size:26rpx;font-weight:600;line-height:1.4}
.diet-macros{display:flex;flex-direction:column;justify-content:space-between;min-width:0;font-size:22rpx;line-height:1.2}
.diet-macros-caption{align-self:end;font-size:20rpx;line-height:1.4;color:#4A6351;text-align:right}
.diet-macro-line{display:flex;justify-content:space-between;align-items:baseline;gap:8rpx;font-variant-numeric:tabular-nums}
.diet-macro-name{flex:none;white-space:nowrap}
.diet-macro-amount{min-width:0;text-align:right;overflow-wrap:anywhere}
.diet-macro-track{height:6rpx;border-radius:6rpx;background:#CFD8C9;overflow:hidden;margin-top:4rpx}
.diet-macro-fill{height:100%;border-radius:6rpx;background:currentColor}
.diet-nutrient-carbGrams{color:#58652E}
.diet-nutrient-proteinGrams{color:#2F7068}
.diet-nutrient-fatGrams{color:#795236}
.diet-line{display:flex;justify-content:space-between;align-items:baseline;gap:10rpx;font-variant-numeric:tabular-nums}
.diet-line>text:last-child{flex:none;white-space:nowrap}
.diet-day-overview{display:flex;align-items:center;gap:16rpx;margin-top:24rpx}
.diet-day-intro{flex:1;min-width:0}
.diet-day-overview .workout-completion-stamp{position:relative;flex:none}
.diet-day-title{margin-bottom:6rpx;font-size:30rpx;font-weight:650;line-height:1.5;overflow-wrap:anywhere}
.diet-hint{margin:16rpx 0;color:#4A6351;font-size:24rpx}
.diet-meals{margin-top:24rpx}
.diet-meal{padding:24rpx 0;border-bottom:1rpx solid #CCD5C6}
.diet-meal:first-child{border-top:1rpx solid #CCD5C6}
.diet-meal-title{font-size:28rpx;font-weight:600}
.diet-meal-state{font-size:21rpx;font-weight:400;margin-left:10rpx;color:#4A6351}
.diet-meal-body{margin-top:12rpx;display:flex;align-items:flex-start;gap:12rpx}
.diet-foods{min-width:0;flex:1}
.diet-food-line{font-size:25rpx;overflow-wrap:anywhere}
.diet-food+.diet-food{margin-top:10rpx;padding-top:10rpx;border-top:1rpx solid #E5EBE1}
.diet-meal-macros{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:12rpx;font-size:22rpx;line-height:1.5;font-variant-numeric:tabular-nums}
.diet-meal-nutrient{padding:4rpx 10rpx;border-radius:8rpx;white-space:nowrap}
.diet-meal-nutrient.diet-nutrient-carbGrams{background:#EBEEDC}
.diet-meal-nutrient.diet-nutrient-proteinGrams{background:#E3EFEB}
.diet-meal-nutrient.diet-nutrient-fatGrams{background:#F3E8DD}
.diet-weight,.diet-meal-text{color:#4A6351;font-size:23rpx;overflow-wrap:anywhere}
.diet-photo{position:relative;width:84rpx;height:84rpx;flex:none;border-radius:8rpx;background:#E7EDDF;overflow:hidden;font-size:18rpx;display:flex;align-items:center;justify-content:center}
.diet-photo image{width:100%;height:100%}
.diet-photo-count{position:absolute;right:0;bottom:0;background:#173E32;color:#fff;padding:0 5rpx}
.diet-capture-actions{display:flex;gap:16rpx;margin-top:16rpx}
.diet-capture-actions button{flex:1;min-width:0;padding-left:12rpx;padding-right:12rpx}
.meal-photo-shade{position:fixed;inset:0;z-index:80;display:flex;align-items:center;justify-content:center;padding:32rpx;background:rgba(15,35,26,.46)}
.meal-progress-panel{width:100%;max-width:640rpx;padding:30rpx 24rpx 20rpx;border-radius:24rpx;background:#F7F8F2;font-family:"PingFang SC",sans-serif}
.meal-progress-title{font-size:32rpx;font-weight:700;text-align:center}
.meal-progress-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:8rpx;margin:24rpx 0}
.meal-progress-step{text-align:center;color:#4A6351;font-size:23rpx}
.meal-progress-step text{display:inline-flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;margin-bottom:8rpx;border-radius:50%;background:#E7EDDF}
.meal-progress-step.is-active{font-weight:700;color:#173E32}
.meal-progress-step.is-active text{color:#fff;background:#173E32}
.meal-progress-status{display:flex;align-items:center;justify-content:center;gap:12rpx;padding-bottom:12rpx;color:#4A6351;font-size:24rpx}
.meal-progress-spinner{width:26rpx;height:26rpx;border:4rpx solid #CCD5C6;border-top-color:#173E32;border-radius:50%;animation:meal-progress-spin .9s linear infinite}
@keyframes meal-progress-spin{to{transform:rotate(360deg)}}
.meal-progress-error{margin:18rpx 0;color:#4A6351;font-size:26rpx}
.meal-progress-panel button{width:100%;margin:12rpx 0 0}
