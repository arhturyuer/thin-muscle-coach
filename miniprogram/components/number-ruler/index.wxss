:host{display:block}.value-line{display:flex;align-items:center;justify-content:center;height:48px;gap:8px}.number-input{width:146px;height:48px;text-align:center;font-size:32px;font-weight:650;color:#173E32;background:transparent;padding:0;border:0}.unit{font-size:13px;color:#6C7C71}.clear{font-size:12px;background:transparent;color:#527964;margin:0;padding:6px;line-height:1.5}.clear::after{border:0}.ruler-wrap{position:relative;margin:4px 0}.ruler-track{width:100%;height:44px}.ruler-content{display:flex;align-items:flex-start;width:max-content;height:44px}.spacer{flex-shrink:0;height:1px}.tick{width:10px;flex-shrink:0;position:relative;font-size:10px;color:#768577}.mark{height:12px;width:1px;background:#B4C4B7}.major .mark{height:20px;background:#6C8D77}.tick text{position:absolute;top:22px;left:0;transform:translateX(-50%)}.indicator{pointer-events:none;position:absolute;left:50%;top:0;width:2px;height:22px;background:#173E32;transform:translateX(-1px)}.hint{text-align:center;color:#768577;font-size:11px;line-height:18px}
