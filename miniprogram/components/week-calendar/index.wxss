.calendar-swiper{height:124rpx}.calendar-week{display:flex;gap:6rpx;height:100%}.calendar-day{flex:1;min-width:0;display:flex;align-items:center;flex-direction:column;justify-content:center;border-radius:12rpx;background:#EEF1E8;color:#687D6D}.small{font-size:20rpx;line-height:1.5}.calendar-selected{background:#173E32;color:#F7F8F2}.calendar-number{font-size:32rpx;font-weight:600;line-height:1.3}.calendar-today{font-size:18rpx;line-height:1.5;white-space:nowrap}
