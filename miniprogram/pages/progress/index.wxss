/* Uses the shared natural movement design system in app.wxss. */
.trend-card{background:#E7EDDF;padding:28rpx;margin:24rpx 0;border-radius:12rpx}.trend-value{font-size:52rpx;line-height:1.5}.trend-plot{height:180rpx;position:relative;margin-top:28rpx;border-bottom:1rpx solid #9BAF9F;background:linear-gradient(to bottom,transparent 49%,#D5DFCE 50%,transparent 51%)}.trend-dot{position:absolute;width:14rpx;height:14rpx;background:#173E32;border:2rpx solid #F7F8F2;border-radius:50%;transform:translate(-50%,-50%)}.trend-axis{display:flex;justify-content:space-between;font-size:20rpx;color:#687D6D;margin-top:12rpx}.habit-row{padding:24rpx 0;border-bottom:1rpx solid #DEE5D9}.habit-bars{background:#E7EDDF;margin-top:16rpx;border-radius:4rpx;overflow:hidden}.habit-training{height:10rpx;background:#173E32}.habit-food{height:10rpx;background:#8EAB80;margin-top:5rpx}
