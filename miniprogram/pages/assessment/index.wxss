/* Anchor the layout to the viewport container, not the native form wrapper. */
.assessment{position:fixed;top:0;left:0;right:0;display:flex;background:#F7F8F2}.assessment-form{display:block}.assessment-layout{position:absolute;top:0;bottom:0;left:0;right:0;display:flex;flex-direction:column;min-height:0}.assessment-header{flex-shrink:0;padding:18px 22px 12px}.step-label{font-size:11px;letter-spacing:1px;color:#6C7C71}.assessment-title{font-size:27px;font-weight:750;line-height:1.3;margin:8px 0 16px}.assessment-content{flex:1;height:0;min-height:0}.content-inner{padding:4px 22px 12px}.intro{font-size:13px;line-height:1.65;color:#6C7C71;margin-bottom:14px}.question{margin-bottom:18px}.question-title{font-size:15px;font-weight:650;line-height:1.5;margin-bottom:9px}.options{display:flex;flex-wrap:wrap;gap:8px}.option{display:flex;align-items:center;flex:1 1 auto;min-height:42px;border:1px solid #D9E2D7;border-radius:9px;padding:9px 12px;font-size:13px;line-height:1.45;background:#FFF}.option radio,.day checkbox{transform:scale(.74);margin-right:3px;flex-shrink:0}.selected{background:#E7EDDF;border-color:#57A885}.vertical{flex-direction:column}.vertical .option{flex:none}.assessment-note{font-size:12px;line-height:1.65;color:#6C7C71;margin:10px 0}.text-input{height:48px;background:#FFF;border:1px solid #D9E2D7;border-radius:9px;padding:0 12px;font-size:14px}.days{display:flex;flex-wrap:wrap;gap:10px}.day{display:flex;align-items:center;justify-content:center;min-height:48px;width:calc((100% - 20px)/3);border:1px solid #D9E2D7;border-radius:9px;font-size:14px}.assessment-footer{flex-shrink:0;padding:10px 22px calc(12px + env(safe-area-inset-bottom));background:#F7F8F2;border-top:1px solid #E5EADF}.assessment-footer.keyboard-open{padding-bottom:10px}.consent-copy{font-size:11px;line-height:1.6;color:#6C7C71;margin-bottom:10px}.consent-copy navigator{display:inline;color:#173E32;text-decoration:underline}.actions{display:flex;gap:10px}.actions button{border-radius:10px;min-height:46px;padding:12px 16px;font-size:15px;line-height:22px}.continue{flex:1;background:#173E32;color:#FFF}.previous{background:#E7EDDF;color:#173E32;flex-shrink:0}.save-hint{text-align:center;font-size:11px;color:#768577;margin-top:7px}.assessment-error{font-size:12px;color:#A04432;margin-top:8px}@media(max-height:580px){.assessment-header{padding-top:10px}.assessment-title{font-size:24px;margin-bottom:10px}.question{margin-bottom:12px}.content-inner{padding-top:0}}
