.explanation-screen{font-family:"PingFang SC",sans-serif}
.explanation-date{font-size:24rpx;color:#526A58}
.explanation-intro{font-size:42rpx;font-weight:750;line-height:1.4;margin:16rpx 0}
.explanation-card{background:#E7EDDF;border-radius:16rpx;padding:32rpx;margin-top:32rpx}
.explanation-heading{font-size:28rpx;font-weight:650;margin-bottom:24rpx}
.explanation-number{font-size:56rpx;font-weight:750;line-height:1.4;word-break:break-word;font-variant-numeric:tabular-nums}
.explanation-number text{font-size:24rpx;font-weight:400;margin-left:12rpx;white-space:nowrap}
.explanation-label{font-size:27rpx;font-weight:600;line-height:1.6;margin-top:16rpx}
.explanation-copy{font-size:26rpx;line-height:1.85;margin-top:16rpx;word-break:break-word}
.explanation-inputs{font-size:24rpx;line-height:1.7;margin-top:24rpx;color:#526A58}
.explanation-formula{font-size:26rpx;font-weight:500;line-height:1.8;background:#F7F8F2;padding:24rpx;border-radius:12rpx;margin-top:24rpx;word-break:break-word}
.explanation-divider{border-top:1rpx solid #C7D5BF;margin:32rpx 0 24rpx}
.explanation-stats{display:flex;gap:24rpx;margin-top:24rpx}
.explanation-stats>view{flex:1;min-width:0;font-size:24rpx;color:#526A58}
.explanation-stats text{display:block;font-size:30rpx;font-weight:600;line-height:1.6;color:#173E32;word-break:break-word}
.explanation-toggle{padding:16rpx 0;margin:16rpx 0 0;background:transparent;color:#173E32;text-align:left;font-size:24rpx;line-height:1.6}
.explanation-details{border-left:4rpx solid #A8BFA0;padding-left:24rpx;margin-top:8rpx}
.movement-explanation{background:#EEF0E6}
.explanation-action{border-top:1rpx solid #CCD5C6;padding:24rpx 0 0;margin-top:24rpx;font-size:26rpx;font-weight:500}
.explanation-small,.explanation-footer{font-size:24rpx;line-height:1.8;color:#526A58;margin-top:24rpx}
.explanation-footer{margin-top:32rpx}
