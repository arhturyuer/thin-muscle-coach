@import "../../styles/diet.wxss";
@import "../../styles/energy-ring.wxss";
/* Custom title bar reserves the status bar and the native capsule area. */
.today-navigation { position:fixed; top:0; left:0; right:0; z-index:25; background:#F7F8F2; }
.today-navigation-row { position:relative; display:flex; align-items:center; }
.today-navigation-content { position:absolute; top:0; bottom:0; display:flex; align-items:center; justify-content:center; gap:12px; }
.today-navigation-title { min-width:0; text-align:center; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; font-size:17px; font-weight:600; color:#173E32; pointer-events:none; }
/* Reserve the original date width to keep the return button in place. */
.navigation-date-spacer { visibility:hidden; }
.navigation-centered-title { position:absolute; top:50%; transform:translateY(-50%); }
.navigation-back-today { flex:none; margin:0; padding:0; height:100%; display:flex; align-items:center; background:transparent; color:#173E32; font-size:13px; line-height:1.4; }
.navigation-back-label { display:flex; align-items:center; height:28px; padding:0 10px; border:1px solid #CCD8CB; border-radius:16px; background:#E7EDDF; white-space:nowrap; font-weight:500; }
.navigation-back-today-pressed .navigation-back-label { background:#D5E1CE; border-color:#A7BDA3; }

/* Landing photos remain still until the user swipes. */
.home-tagline { font-size:56rpx; line-height:1.4; letter-spacing:-1rpx; white-space:nowrap; margin:4rpx 0 32rpx; }
.photo-gallery { position:relative; border-radius:12rpx; overflow:hidden; }
.photo-swiper { width:100%; height:446rpx; }
.gallery-photo { display:block; width:100%; height:100%; }
.photo-count { position:absolute; right:20rpx; top:20rpx; padding:4rpx 16rpx; border-radius:24rpx; color:#FFFFFF; background:rgba(23,62,50,0.65); font-size:22rpx; pointer-events:none; }
.gallery-caption { display:flex; justify-content:space-between; gap:16rpx; font-size:20rpx; color:#6C7C71; margin-top:16rpx; }

/* The anchor always retains the button's height, so docking never shifts content. */
.guide-anchor { margin-top:28rpx; }
.guide-action { margin-top:0; }
.guide-dock { position:fixed; left:0; right:0; z-index:20; padding:12rpx 0; background:#F7F8F2; pointer-events:none; }
.guide-dock .guide-action { pointer-events:auto; }
.guide-dock-top { top:0; box-shadow:0 4rpx 16rpx rgba(23,62,50,0.06); }
.guide-dock-bottom { bottom:0; box-shadow:0 -4rpx 16rpx rgba(23,62,50,0.06); }

.calendar-screen { padding-top:0; }
.calendar-fixed { position:fixed; top:0; left:0; right:0; z-index:15; padding:12rpx 40rpx; background:#F7F8F2; border-bottom:1rpx solid #DEE5D9; }
.calendar-spacer { height:150rpx; }
.calendar-swiper { height:124rpx; }
.calendar-week { display:flex; gap:6rpx; height:100%; }
.calendar-day { flex:1; min-width:0; display:flex; align-items:center; flex-direction:column; justify-content:center; border-radius:12rpx; background:#EEF1E8; color:#687D6D; gap:0; }
.calendar-day .small { font-size:20rpx; line-height:1.5; }
.calendar-selected { background:#173E32; color:#F7F8F2; }
.calendar-number { font-size:32rpx; font-weight:600; line-height:1.3; }
.calendar-today { font-size:18rpx; line-height:1.5; white-space:nowrap; }
.calendar-empty { margin-top:24rpx; }

.first-plan-title { margin-top:24rpx; }
.plan-heading-actions { display:flex; align-items:center; gap:20rpx; }

.daily-actions { display:flex; align-items:center; gap:20rpx; flex-wrap:wrap; }
.daily-actions button { flex:1; margin-left:0; margin-right:0; min-width:140rpx; }
.meal-tabs { display:flex; gap:12rpx; flex-wrap:wrap; margin:16rpx 0; }
.meal-tab { margin:0; padding:12rpx 20rpx; font-size:24rpx; line-height:1.6; background:#EEF1E8; color:#173E32; border-radius:12rpx; }
.meal-tab.chosen { background:#173E32; color:#fff; }
.composer-shade { position:fixed; inset:0; background:rgba(15,35,26,.3); z-index:30; }
.composer-panel { position:absolute; left:0; right:0; padding:24rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); border-radius:24rpx 24rpx 0 0; background:#F7F8F2; box-sizing:border-box; max-height:90vh; }
.composer-panel .section-title { margin-top:0; }
.composer-results { max-height:44vh; }
.composer-input-row { display:flex; gap:16rpx; align-items:center; }
.composer-input-row textarea { flex:1; height:100rpx; min-height:100rpx; padding:16rpx; box-sizing:border-box; background:#fff; border-radius:12rpx; font-size:28rpx; }
.composer-input-row .primary { margin:0; font-size:26rpx; padding:16rpx 24rpx; }

.save-notice { overflow:hidden; background:#E7EDDF; border:1rpx solid #DEE5D9; border-radius:12rpx; }
.save-notice-content { display:flex; justify-content:space-between; align-items:center; padding:12rpx 24rpx; }
.save-notice-track { height:6rpx; background:#CCD8CB; }
.save-notice-progress { height:100%; background:#173E32; transition:width 50ms linear; }
.composer-save-notice { margin-bottom:16rpx; }
.daily-save-notice { position:fixed; left:24rpx; right:24rpx; bottom:calc(24rpx + env(safe-area-inset-bottom)); z-index:24; }

/* Two date-scoped management panels share the established natural palette. */
.management-card{margin-top:32rpx;padding:32rpx;border-radius:16rpx;background:#E7EDDF;font-family:"PingFang SC",sans-serif}
.management-heading,.exercise-row-heading{display:flex;justify-content:space-between;align-items:center;gap:16rpx}
.management-heading{margin-bottom:32rpx}
.management-title{flex:1;min-width:0;font-size:34rpx;font-weight:750;line-height:1.4;white-space:nowrap}
.management-subtitle{font-size:26rpx;font-weight:500;margin-left:8rpx}
.management-link{flex:none;margin:0;padding:12rpx 0;background:transparent;color:#173E32;font-size:24rpx;line-height:1.5;text-align:left;min-height:64rpx;display:flex;align-items:center}
.management-meta{font-size:24rpx;line-height:1.6;margin-top:8rpx}
.management-note{font-size:22rpx;line-height:1.6;color:#526A58;margin-top:8rpx;overflow-wrap:break-word}
.meal-overview{margin-top:32rpx;border-top:1rpx solid #C7D5BF}
.meal-overview-row{display:flex;gap:16rpx;padding:24rpx 0;border-bottom:1rpx solid #C7D5BF;align-items:flex-start}
.meal-slot{flex:none;font-size:26rpx;font-weight:600}
.meal-overview-main{flex:1;min-width:0}
.meal-overview-text{font-size:26rpx;line-height:1.6;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all}
.meal-state{display:inline-block;font-size:20rpx;color:#526A58;margin-top:8rpx}
.meal-recorded{font-weight:600;color:#173E32}
.row-chevron{color:#526A58;font-size:28rpx;flex:none}
.capture-actions{margin-top:24rpx;gap:16rpx}
.capture-actions button{min-width:0;padding:24rpx 16rpx;margin-top:0}
.management-empty{margin-top:24rpx;font-size:26rpx}
.exercise-management{background:#EEF0E6}
.breakdown-heading{font-size:24rpx;align-items:flex-start;flex-wrap:wrap;gap:8rpx}
.exercise-overview{position:relative;margin-top:32rpx;border-top:1rpx solid #CCD5C6;padding-top:32rpx}
.exercise-overview .workout-completion-stamp{top:0;right:0}
.today-workout-title{font-size:30rpx;font-weight:650;line-height:1.5;word-break:break-all}
.exercise-overview-row{padding:24rpx 0;border-bottom:1rpx solid #CCD5C6}
.exercise-name{flex:1;min-width:0;font-size:28rpx;font-weight:600;word-break:break-all}
.exercise-prescription{font-size:24rpx;margin-top:8rpx;color:#4A6351}
.exercise-muscles{color:#795236;font-size:22rpx;max-width:48%;text-align:right}
.exercise-detail-link{flex-shrink:0;font-size:24rpx;color:#4A6351}
.steps-overview{border-top:1rpx solid #CCD5C6;margin-top:32rpx;padding-top:24rpx}
.steps-heading{font-size:26rpx;font-weight:600}
.steps-count{font-size:40rpx;line-height:1.5;font-weight:700;word-break:break-word;font-variant-numeric:tabular-nums}
.steps-count text{font-size:24rpx;font-weight:400}
.management-heading .management-link{width:88rpx;flex:0 0 88rpx;justify-content:flex-end}

/* The equality shares one grid row; ring centers stay aligned at every phone width. */
.energy-rings{display:grid;grid-template-columns:minmax(0,1.35fr) 24rpx minmax(0,1fr) 24rpx minmax(0,1fr);column-gap:8rpx;row-gap:8rpx;align-items:center}
.ring-total{grid-column:1}
.ring-activity{grid-column:3}
.ring-training{grid-column:5}
.ring-title{grid-row:1;font-size:24rpx;font-weight:600;text-align:center;white-space:nowrap;margin-bottom:8rpx}
.ring-visual{grid-row:2;min-width:0}
.ring-operator{grid-row:2;font-size:28rpx;text-align:center;color:#526A58;line-height:1}
.ring-equals{grid-column:2}
.ring-plus{grid-column:4}
.ring-remaining{grid-row:3;font-size:18rpx;font-weight:600;text-align:center;line-height:1.5;overflow-wrap:break-word}
.ring-training.ring-title,.ring-training.ring-remaining{color:#795236}

.steps-sync-row{display:flex;align-items:center;gap:8rpx;margin-top:8rpx;min-height:64rpx}
.steps-sync-time{font-size:22rpx;line-height:1.6;color:#526A58}
.steps-sync-button{display:flex;align-items:center;justify-content:center;flex:none;width:64rpx;height:64rpx;min-height:0;margin:0;padding:16rpx;background:transparent;border-radius:50%;line-height:1}
.steps-sync-icon{display:block;width:32rpx;height:32rpx}
.steps-syncing .steps-sync-icon{animation:steps-sync-spin 1s linear infinite}
.steps-permission{margin-top:8rpx}
@keyframes steps-sync-spin{to{transform:rotate(360deg)}}
.steps-sync-row .steps-sync-button{flex:0 0 64rpx;width:64rpx;margin-left:0;margin-right:0}

.ring-remaining{margin-top:8rpx;min-height:40rpx;display:flex;align-items:center;justify-content:center}
.ring-remaining.ring-total{gap:4rpx}
.ring-remaining.ring-total text{min-width:0}
.ring-total .ring-help{display:inline-flex;flex:0 0 40rpx;align-items:center;justify-content:center;width:40rpx;height:48rpx;margin-left:0;margin-right:0;padding:8rpx;background:transparent;border-radius:50%;line-height:1}
.ring-help image{display:block;width:24rpx;height:24rpx}
