.record-exercise { margin: 0 0 24rpx; padding: 24rpx; }
.record-focused { border: 2rpx solid #8B6345; }
.record-sets-toolbar, .record-set-controls {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.record-sets-toolbar { justify-content: space-between; margin: 20rpx 0 12rpx; }
.record-set-controls { flex: none; }
.record-set-controls button.record-set-button {
  flex: 0 0 72rpx;
  width: 72rpx;
  min-width: 0;
  min-height: 72rpx;
  padding: 0;
  border: 1rpx solid #C5D3C0;
  border-radius: 8rpx;
  background: #F7F8F2;
  color: #173E32;
  font-size: 36rpx;
}
.record-set-row {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr) minmax(0, 1fr) 84rpx;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  text-align: center;
}
.record-set-head { font-size: 23rpx; color: #4A6351; }
.record-set-row input {
  width: 100%;
  height: 72rpx;
  padding: 8rpx;
  border: 1rpx solid #C5D3C0;
  border-radius: 8rpx;
  background: #F7F8F2;
}
.record-check { display: flex; align-items: center; justify-content: center; height: 72rpx; }
.record-check checkbox, .record-feelings radio { transform: scale(.85); }
.record-feelings {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 4rpx;
  margin-top: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #CFD9CB;
}
.record-feelings label { display: flex; align-items: center; min-height: 72rpx; font-size: 26rpx; }
