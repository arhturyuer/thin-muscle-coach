<view class="screen"><view wx:if="{{vm.config.testCheckout}}" class="notice">测试方案 · 热量与营养数值为估算，请结合实际执行反馈。</view><view class="eyebrow">我的薄肌计划</view><view class="title">从今天，<text>{{'\n'}}</text>一点点靠近。</view><view wx:if="{{vm.isMember}}" class="tag">指导服务有效至 {{vm.membershipUntil}} · 无自动续费</view><view wx:if="{{loading}}" class="notice">正在读取你的安排…</view><button wx:if="{{vm.isMember && !plan && !loading}}" class="secondary" bindtap="onShow" disabled="{{busy}}">重新读取我的计划</button><view wx:if="{{plan}}"><view class="body-copy">{{plan.direction || plan.reason}}</view><view wx:if="{{plan.energyTargets}}" class="hero"><view class="task-title">目标体重 {{plan.energyTargets.targetWeight}} 千克 · {{plan.energyTargets.direction==='loss'?'减重':plan.energyTargets.direction==='gain'?'增重':'维持'}}</view><view class="body-copy">{{plan.energyTargets.direction==='maintain'?'维持体重':plan.energyTargets.estimatedWeeks?'本轮起点预计 '+plan.energyTargets.estimatedWeeks+' 周':'建议分阶段复评'}} · 每日摄入 {{plan.energyTargets.intakeKcal}} 千卡</view><view class="fine">{{plan.energyTargets.note}}</view></view><navigator wx:else class="secondary" url="/pages/assessment/index">补充目标体重与步数</navigator><view class="section-title">今天先做什么</view><view wx:if="{{vm.config.workoutPlansSupported}}" class="hero"><view class="task-title workout-title">{{workoutView.day?workoutView.day.title:'本周运动方案'}}</view><view class="body-copy workout-reason">{{workoutView.day?workoutView.day.reason:workoutView.message||'查看运动计划生成状态'}}</view><button class="primary" bindtap="begin">{{vm.session?'继续原计时训练':workoutView.canRecord?'记录运动':'查看运动方案'}}</button><navigator class="secondary" url="/pages/exercise-detail/index">查看完整运动安排</navigator></view><view wx:if="{{today && !vm.config.workoutPlansSupported}}" class="hero"><view class="task-title">{{today.title}}</view><view class="body-copy">{{today.rest?'给身体留出恢复时间，完成今天的饮食任务。':todayMinutes+' 分钟居家训练，按动作指导逐组完成。'}}</view><view class="muted">{{today.nutrition}}</view><button wx:if="{{vm.active}}" class="primary" bindtap="begin" loading="{{busy}}" disabled="{{busy}}">{{vm.session?'继续上次训练':completed?'训练已完成，记录饮食':'开始今天的安排'}}</button></view><button wx:if="{{!today && vm.isMember}}" class="secondary" bindtap="onShow" disabled="{{busy}}">重新读取本周计划</button>
<block wx:if="{{!vm.config.workoutPlansSupported}}"><view class="section-title">{{weeklyStart}} 起 · 本周 {{planDays}} 次训练</view><view wx:for="{{plan.days}}" wx:key="index" class="list-row"><text class="mono">0{{index+1}}</text><view class="grow"><view>{{item.title}}</view><view class="muted">{{item.nutrition}}</view></view></view></block><block wx:elif="{{workoutView.plan}}"><view class="section-title">{{workoutView.plan.weekStart}} — {{workoutView.plan.weekEnd}}</view><navigator wx:for="{{workoutView.plan.days}}" wx:key="date" class="list-row" url="/pages/exercise-detail/index?date={{item.date}}"><text>{{item.date}}</text><view class="grow workout-title">{{item.title}}</view></navigator></block><view class="section-title">适合你的饮食安排</view><view wx:if="{{plan.nutrition}}"><view class="body-copy">{{plan.nutrition.scene}}</view><view wx:for="{{plan.nutrition.meals}}" wx:key="*this" class="choice">{{item}}</view><view class="muted">{{plan.nutrition.alternative}}</view><view wx:if="{{plan.nutrition.numericEnabled || plan.nutrition.reviewed}}" class="notice">估算每日 {{plan.nutrition.energy}} 千卡 · 蛋白质 {{plan.nutrition.protein}} 克 · 脂肪 {{plan.nutrition.fat}} 克 · 碳水 {{plan.nutrition.carbohydrate}} 克；三餐按约 30% / 40% / 30% 分配。{{plan.nutrition.note}}</view></view><view class="section-title">每周回顾，继续调整</view><view class="body-copy">记录实际执行与感受，每周回顾。确认后的调整从下一周开始，今天的训练记录会保留。</view><navigator class="secondary" url="/pages/progress/index" open-type="switchTab">去成长页复评</navigator><navigator wx:if="{{vm.isMember && vm.config.aiEnabled}}" class="secondary" url="/pages/guidance/index">问问 AI 教练</navigator></view><view wx:if="{{!vm.isMember && !vm.active && !loading}}" class="empty">指导服务尚未开通或已到期，历史记录仍可查看。<navigator class="primary" url="/pages/assessment/index">评估并查看套餐</navigator></view></view>
